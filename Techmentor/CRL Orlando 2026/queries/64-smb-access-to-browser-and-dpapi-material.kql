// 64: SMB access to browser and DPAPI material
// OPTIONAL SENTINEL / SECURITYEVENT
// Requires: SecurityEvent 5145; Audit Detailed File Share on WIN11B
// Historical lab window: adjust for replay. Run this file alone.
// Local static validation is not portal execution. See Query-Guide.md.
let StartUtc = datetime(2026-11-11T15:00:00Z);
let EndUtc = datetime(2026-11-13T00:00:00Z);
SecurityEvent
| where TimeGenerated between (StartUtc .. EndUtc)
| extend ShortComputer=tolower(tostring(split(Computer,".")[0]))
| where ShortComputer == "win11b" and EventID == 5145
| extend ClientIP=coalesce(tostring(column_ifexists("IpAddress","")),extract('<Data Name="IpAddress">([^<]*)</Data>',1,EventData)), RelativePath=coalesce(tostring(column_ifexists("RelativeTargetName","")),extract('<Data Name="RelativeTargetName">([^<]*)</Data>',1,EventData)), Share=coalesce(tostring(column_ifexists("ShareName","")),extract('<Data Name="ShareName">([^<]*)</Data>',1,EventData)), Actor=coalesce(tostring(column_ifexists("SubjectUserName","")),extract('<Data Name="SubjectUserName">([^<]*)</Data>',1,EventData))
| where replace_string(ClientIP,"::ffff:","") == "192.168.57.5"
    or RelativePath contains "Login Data" or RelativePath contains "Local State"
    or RelativePath contains @"Microsoft\Protect" or RelativePath contains @"Microsoft\Credentials" or RelativePath contains @"Microsoft\Vault"
| project TimeGenerated, Computer, Actor, ClientIP, Share, RelativePath, AccessMask, EventData
| order by TimeGenerated asc
