// 34: LSASS dump and access candidates
// DEFENDER XDR ADVANCED HUNTING
// Requires: MDE DeviceProcessEvents
// Historical lab window: adjust for replay. Run this file alone.
// Local static validation is not portal execution. See Query-Guide.md.
let StartUtc = datetime(2026-11-11T15:00:00Z);
let EndUtc = datetime(2026-11-13T00:00:00Z);
DeviceProcessEvents
| where Timestamp between (StartUtc .. EndUtc)
| extend ShortDevice = tolower(tostring(split(DeviceName, ".")[0]))
| where ShortDevice in ("win11", "win11b", "dc01", "srv01")
| where FileName in~ ("procdump.exe","procdump64.exe","nanodump.exe","nano.exe","handlekatz.exe","rundll32.exe","taskmgr.exe")
    or ProcessCommandLine contains "lsass" or ProcessCommandLine contains "comsvcs" or ProcessCommandLine contains "MiniDump"
| where FileName !~ "rundll32.exe" or ProcessCommandLine contains "comsvcs" or ProcessCommandLine contains "MiniDump"
| project Timestamp, DeviceName, AccountName, FileName, ProcessCommandLine, ProcessTokenElevation, InitiatingProcessFileName, InitiatingProcessCommandLine
| order by Timestamp asc
